<div class="registration-form" id="signup">
  <%= link_to new_session_path(resource_name) do %>
    <i class="bi bi-arrow-left-circle"></i>
  <% end %>
  <h2>Sign up</h2>

  <div class="session">
    <%= bootstrap_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.email_field :email, placeholder: 'name@example.com', autofocus: true, autocomplete: "email" %>
      <%= f.text_field :name, autocomplete: "name", placeholder: "John Doe" %>
      <div>
        <%= f.file_field :user_image, accept: 'image/*', class: 'form-control' %>
      </div>
      <%= f.text_area :bio, autocomplete: "bio", placeholder: 'Add bio'%>
      <%= f.collection_select :role, User::ROLES, :to_s, :humanize %>
      <%= f.password_field :password, help: 'A good password should be at least six characters long' %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      <div class="actions">
        <%= f.submit "Sign up", class: "btn btn-secondary col-12 mb-2 session_btn" %>
      </div>
    <% end %>
  </div>
  <p>Already have and account? <%= link_to "Log in", new_session_path(resource_name), class: "login" %><br />
</div>
