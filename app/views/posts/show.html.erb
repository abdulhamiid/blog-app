<div class="post-show-page container">

  <div class="post-show-back" id="back">
    <%= link_to user_path(@user), aria: { label: "Back to user profile" } do %>
      <i class="bi bi-arrow-left-circle-fill"></i>
      <span>Back to profile</span>
    <% end %>
  </div>

  <article class="post-detail-card">
    <div class="post-detail-header">
      <div class="post-author-avatar">
        <i class="bi bi-person-fill"></i>
      </div>

      <div class="post-author-info">
        <p class="post-author-name">
          <%= @post.author.name %>
        </p>
        <span class="post-author-label">Community post</span>
      </div>
    </div>

    <div class="post-detail-content">
      <p><%= @post.text %></p>
    </div>

    <div class="post-detail-stats">
      <span>
        <i class="bi bi-chat-dots-fill"></i>
        <%= @post.comments_counter || 0 %> Comments
      </span>

      <span>
        <i class="bi bi-hand-thumbs-up-fill"></i>
        <%= @post.likes_counter || 0 %> Likes
      </span>
    </div>

    <div class="post-detail-actions">
      <%= form_with url: user_post_likes_path(@post.author, @post), method: :post do %>
        <%= button_tag type: "submit", class: "post-like-btn" do %>
          <i class="bi bi-hand-thumbs-up-fill"></i>
          Like post
        <% end %>
      <% end %>

      <% if can? :destroy, @post %>
        <%= link_to user_post_path(@post.author, @post),
          data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this post?" },
          class: "post-delete-btn" do %>
          <i class="bi bi-trash-fill"></i>
          Delete post
        <% end %>
      <% end %>
    </div>
  </article>

  <section class="post-comments-section">
    <div class="comments-heading">
      <div>
        <h2>Comments</h2>
        <p>Join the conversation.</p>
      </div>

      <%= link_to new_user_post_comment_path(@post.author, @post),
        class: "add-comment-btn" do %>
        <i class="bi bi-plus-circle-fill"></i>
        Add comment
      <% end %>
    </div>

    <% if @post.comments.exists? %>
      <ul class="post-comments-list">
        <% @post.comments.includes(:author).each do |comment| %>
          <li class="post-comment-card">
            <div class="comment-avatar">
              <i class="bi bi-person-fill"></i>
            </div>

            <div class="comment-body">
              <p class="comment-author"><%= comment.author.name %></p>
              <p class="comment-text"><%= comment.text %></p>
            </div>

            <% if can? :destroy, comment %>
              <%= link_to user_post_comment_path(@post.author, @post, comment),
                data: { turbo_method: :delete, turbo_confirm: "Delete this comment?" },
                class: "comment-delete-btn",
                aria: { label: "Delete comment" } do %>
                <i class="bi bi-trash3-fill"></i>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="comments-empty-state">
        <i class="bi bi-chat-square-text"></i>
        <h3>No comments yet</h3>
        <p>Be the first to share your thoughts on this post.</p>
      </div>
    <% end %>
  </section>

</div>