<header>
  <%= image_tag @user.user_image, class: 'rounded-circle', alt: 'profile_img', width: 70, height: 70 if @user.user_image.attached? %>
  <div>
    <h1><%= @user.name %></h1>
    <p class="ms-auto">
    <span>Number of posts: </span>
    <span><%= @user.posts_counter || 0 %></span>
    </p>
  </div>
</header>