<div id="home">
  <%= link_to root_path, aria: { label: "Home" } do %>
    <i class="bi bi-house-door-fill"></i>
  <% end %>
</div>

<section class="profile-container container">
  <%= render "nav" %>

  <section class="bio-card">
    <div class="section-heading">
      <span class="section-icon">
        <i class="bi bi-person-lines-fill"></i>
      </span>
      <h2>About Me</h2>
    </div>

    <p class="bio-text">
      <%= @user.bio.presence || "This user hasn't added a bio yet." %>
    </p>
  </section>

  <section class="posts-section">
    <div class="section-heading">
      <span class="section-icon">
        <i class="bi bi-journal-text"></i>
      </span>
      <h2>Recent Posts</h2>
    </div>

    <div class="posts-list">
      <% @user.recent_posts.each do |post| %>
        <%= link_to user_post_path(@user.id, post.id),
            class: "post-card" do %>
          <div class="post-card-content">
            <h4><%= post.title %></h4>
            <p><%= truncate(post.text, length: 180) %></p>
            <span class="read-more">
              Read post <i class="bi bi-arrow-right"></i>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="posts-footer">
      <%= link_to user_posts_path(@user),
          class: "all-posts-btn" do %>
        See all posts
        <i class="bi bi-arrow-up-right"></i>
      <% end %>
    </div>
  </section>
</section>
